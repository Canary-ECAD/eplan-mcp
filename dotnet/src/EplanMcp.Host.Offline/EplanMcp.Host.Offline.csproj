<Project Sdk="Microsoft.NET.Sdk">
  <!-- The script host without an EPLAN window (EPLAN's "offline application"). Long-lived: started
       once by the server, serves a queue folder, exits on "stop" or after being idle. Per EPLAN's
       rules the exe itself references only the Starter library; everything EPLAN-bound sits in
       EplanMcp.Scripting and is touched only after PinToEplan. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(EplanTargetFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EplanMcp.Host.Offline</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\offline\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'" />
    <ProjectReference Include="..\EplanMcp.Scripting\EplanMcp.Scripting.csproj" />
    <ProjectReference Include="..\EplanMcp.Eplan\EplanMcp.Eplan.csproj" />
    <Reference Include="Eplan.EplApi.Starter$(EplanApiSuffix)" HintPath="$(EplanBinPath)\Eplan.EplApi.Starter$(EplanApiSuffix).dll" Private="false" />
  </ItemGroup>
  <Target Name="WriteHostFlavor" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)eplanmcp-flavor.txt" Overwrite="true" Lines="$(EplanHostFlavor)" />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EplanBinPath</_Parameter1>
      <_Parameter2>$(EplanBinPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
