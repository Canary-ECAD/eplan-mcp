<Project Sdk="Microsoft.NET.Sdk">
  <!-- The EPLAN side of the script host: ScriptContext, project resolution, the write gate and the
       entry points the add-in action and the script bootstrap call. Needs an installed EPLAN to
       build (the API assemblies are referenced in place and never copied). -->
  <PropertyGroup>
    <TargetFramework>$(EplanTargetFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EplanMcp.Scripting</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- EPLAN's *Netu assemblies are compiled against WindowsDesktop; without it MSBuild cannot
         unify WindowsBase / System.Drawing (MSB3277). EPLAN's process loads it either way. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'" />
    <ProjectReference Include="..\EplanMcp.Scripting.Core\EplanMcp.Scripting.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Eplan.EplApi.AF$(EplanApiSuffix)" HintPath="$(EplanBinPath)\Eplan.EplApi.AF$(EplanApiSuffix).dll" Private="false" />
    <Reference Include="Eplan.EplApi.Base$(EplanApiSuffix)" HintPath="$(EplanBinPath)\Eplan.EplApi.Base$(EplanApiSuffix).dll" Private="false" />
    <Reference Include="Eplan.EplApi.DataModel$(EplanApiSuffix)" HintPath="$(EplanBinPath)\Eplan.EplApi.DataModel$(EplanApiSuffix).dll" Private="false" />
    <Reference Include="Eplan.EplApi.HEServices$(EplanApiSuffix)" HintPath="$(EplanBinPath)\Eplan.EplApi.HEServices$(EplanApiSuffix).dll" Private="false" />
    <Reference Include="Eplan.EplApi.System$(EplanApiSuffix)" HintPath="$(EplanBinPath)\Eplan.EplApi.System$(EplanApiSuffix).dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Bootstrap\bootstrap.cs.template" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
